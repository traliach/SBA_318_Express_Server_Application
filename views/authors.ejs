<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Authors</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <header class="header">
        <h1>Authors</h1>
        <p class="muted"><a href="/books">Back to Books</a></p>
      </header>

      <section class="card">
        <h2>Current authors</h2>
        <% if (error) { %>
          <p class="muted"><strong>Error:</strong> <%= error %></p>
        <% } %>
        <p class="muted">Create new authors on the <a href="/books">Books</a> page.</p>
        <% if (!authors.length) { %>
          <p class="muted">No authors yet.</p>
        <% } else { %>
          <table class="table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% authors.forEach((a) => { %>
                <tr>
                  <td><%= a.name %></td>
                  <td>
                    <div class="actions">
                      <form action="/authors/<%= a.id %>/edit" method="POST">
                        <input name="name" value="<%= a.name %>" />
                        <button class="btn btn-primary" type="submit">Rename</button>
                      </form>
                      <form action="/authors/<%= a.id %>/delete" method="POST">
                        <button class="btn btn-danger" type="submit">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </section>
    </main>
  </body>
</html>
