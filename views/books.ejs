<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mini Library — Books</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <header class="header">
        <h1>Books</h1>
        <p class="muted">Server-rendered page with a form that posts to <code>/api/books</code>.</p>
      </header>

      <section class="card">
        <h2>Add an author</h2>
        <form class="form" action="/api/authors" method="POST">
          <label>
            Name
            <input name="name" required placeholder="Barack Obama" />
          </label>
          <button type="submit">Create author</button>
        </form>
        <p class="muted">After creating an author, use the dropdown below to add a book.</p>
      </section>

      <section class="card">
        <h2>Add a book</h2>
        <form class="form" action="/api/books" method="POST">
          <label>
            Title
            <input name="title" required />
          </label>

          <label>
            Author
            <select name="authorId" required>
              <option value="" selected disabled>Select an author</option>
              <% authors.forEach((a) => { %>
                <option value="<%= a.id %>"><%= a.name %></option>
              <% }) %>
            </select>
          </label>

          <label>
            Genre
            <input name="genre" placeholder="classic, sci-fi, ..." />
          </label>

          <label>
            Year
            <input name="year" type="number" min="0" />
          </label>

          <button type="submit">Create</button>
        </form>

        <p class="muted">
          After you submit, you’ll be redirected back here and the new book will appear in the list.
        </p>
      </section>

      <section class="card">
        <h2>Current books</h2>
        <% if (!books.length) { %>
          <p class="muted">No books yet.</p>
        <% } else { %>
          <table class="table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>Year</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% books.forEach((b) => { %>
                <tr>
                  <td><%= b.title %></td>
                  <td><%= b.authorName %></td>
                  <td><%= b.genre %></td>
                  <td><%= b.year ?? "" %></td>
                  <td>
                    <form action="/books/<%= b.id %>/delete" method="POST">
                      <button type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </section>
    </main>
  </body>
</html>
